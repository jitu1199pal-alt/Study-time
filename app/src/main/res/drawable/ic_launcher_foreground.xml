    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing yellow/gold cone of light from the study lamp -->
    <path
        android:pathData="M 28,40 L 58,62 L 32,62 Z"
        android:fillColor="#55FFEB3B"/>

    <!-- Clock of the wall -->
    <group android:name="clock">
        <!-- Clock Outer Ring -->
        <path
            android:pathData="M 78 28 A 6 6 0 1 0 78 40 A 6 6 0 1 0 78 28 Z"
            android:fillColor="#E1F5FE"
            android:strokeColor="#1E3A8A"
            android:strokeWidth="0.8"/>
        <!-- Clock Center -->
        <path
            android:pathData="M 78 34 A 0.5 0.5 0 1 0 78 35 A 0.5 0.5 0 1 0 78 34 Z"
            android:fillColor="#1E1E24"/>
        <!-- Clock Hands pointing to 2 o'clock -->
        <path
            android:pathData="M 78 34.5 L 78 32"
            android:strokeColor="#1E1E24"
            android:strokeWidth="0.5"/>
        <path
            android:pathData="M 78 34.5 L 81 33"
            android:strokeColor="#1E1E24"
            android:strokeWidth="0.5"/>
    </group>

    <!-- Checklist on the wall -->
    <group android:name="checklist" android:translateX="2" android:translateY="2">
        <path
            android:pathData="M 76 38 H 82 V 46 H 76 Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#3B82F6"
            android:strokeWidth="0.4"/>
        <!-- Quick checklist lines -->
        <path
            android:pathData="M 78 40 H 81 M 78 42 H 81 M 78 44 H 81"
            android:strokeColor="#64748B"
            android:strokeWidth="0.3"/>
    </group>

    <!-- Potted Plant on Desk -->
    <group android:name="plant">
        <!-- Small Grey Pot -->
        <path
            android:pathData="M 22 55 L 25 55 L 24 59 L 23 59 Z"
            android:fillColor="#94A3B8"/>
        <!-- Green Plant Leaves -->
        <path
            android:pathData="M 23.5 55 C 22.5 53, 22.5 51, 23.5 50 C 24.5 51, 24.5 53, 23.5 55"
            android:fillColor="#22C55E"/>
        <path
            android:pathData="M 22.5 55 C 21 54, 21 53, 22 52 C 23 53, 23 54, 22.5 55"
            android:fillColor="#15803D"/>
        <path
            android:pathData="M 24.5 55 C 26 54, 26 53, 25 52 C 24 53, 24 54, 24.5 55"
            android:fillColor="#15803D"/>
    </group>

    <!-- Desk Lamp -->
    <group android:name="desk_lamp">
        <!-- Base -->
        <path
            android:pathData="M 24 56 C 24 55, 29 55, 29 56 Z"
            android:strokeColor="#1E293B"
            android:strokeWidth="1.2"
            android:fillColor="#0F172A"/>
        <!-- Arm (flexible neck joints) -->
        <path
            android:pathData="M 26.5 55 L 24 47 L 27 41"
            android:strokeColor="#0F172A"
            android:strokeWidth="1"
            android:fillColor="#00000000"/>
        <!-- Lamp Head Shade -->
        <path
            android:pathData="M 25 41 A 3 3 0 0 1 31 39 L 29 43 Z"
            android:fillColor="#1F2937"/>
        <path
            android:pathData="M 26 42 A 1 1 0 0 1 29 41"
            android:fillColor="#FCD34D"/>
    </group>

    <!-- Student sitting and writing -->
    <group android:name="student">
        <!-- Shoulders / Hoodie Body -->
        <path
            android:pathData="M 33,59 C 32,53  40,49  44,48 L 54,48 L 64,48 C 68,49  76,53  75,59 Z"
            android:fillColor="#1E3A8A"/>
        <!-- Hoodie V-neck and strings -->
        <path
            android:pathData="M 50,48 L 54,53 L 58,48"
            android:strokeColor="#3B82F6"
            android:strokeWidth="0.8"
            android:fillColor="#00000000"/>
        <path
            android:pathData="M 52,51 L 52,56 M 56,51 L 56,56"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="0.5"/>
        <!-- Neck -->
        <path
            android:pathData="M 51,48 L 51,44 L 57,44 L 57,48 Z"
            android:fillColor="#FDBA74"/>
        <!-- Face -->
        <path
            android:pathData="M 47,43 C 47,36, 61,36, 61,43 C 61,46, 47,46, 47,43 Z"
            android:fillColor="#FFD3A5"/>
        <!-- Glasses -->
        <path
            android:pathData="M 49,41 A 1.8 1.8 0 1 0 52.6 41 A 1.8 1.8 0 1 0 49 41 Z"
            android:strokeColor="#1E293B"
            android:strokeWidth="0.6"
            android:fillColor="#00000000"/>
        <path
            android:pathData="M 55.4 41 A 1.8 1.8 0 1 0 59 41 A 1.8 1.8 0 1 0 55.4 41 Z"
            android:strokeColor="#1E293B"
            android:strokeWidth="0.6"
            android:fillColor="#00000000"/>
        <!-- Glasses Bridge -->
        <path
            android:pathData="M 52.6,41 L 55.4,41"
            android:strokeColor="#1E293B"
            android:strokeWidth="0.6"/>
        <!-- Hair -->
        <path
            android:pathData="M 47,38 C 47,33, 61,33, 61,38 C 60,35, 48,35, 47,38"
            android:fillColor="#1E1E24"/>
        <path
            android:pathData="M 46,38 C 48,31, 56,31, 56,33 C 58,31, 62,33, 60,38"
            android:strokeColor="#1E1E24"
            android:strokeWidth="1"
            android:fillColor="#1E1E24"/>
        <!-- Studying Eyes -->
        <path
            android:pathData="M 50.5 41.2 L 51.5 41.2 M 56.5 41.2 L 57.5 41.2"
            android:strokeColor="#1E293B"
            android:strokeWidth="0.6"/>
    </group>

    <!-- Stack of Books on Right -->
    <group android:name="books" android:translateX="2" android:translateY="2">
        <!-- Bottom Book (Blue) -->
        <path
            android:pathData="M 68 53 H 83 V 56 H 68 Z"
            android:fillColor="#1D4ED8"/>
        <path
            android:pathData="M 83 53 H 84 V 56 H 83 Z"
            android:fillColor="#E2E8F0"/>
        <!-- Middle Book (Orange) -->
        <path
            android:pathData="M 69 50 H 81 V 53 H 69 Z"
            android:fillColor="#EA580C"/>
        <path
            android:pathData="M 81 50 H 82 V 53 H 81 Z"
            android:fillColor="#E2E8F0"/>
        <!-- Top Book (Cyan/Teal) -->
        <path
            android:pathData="M 70 47 H 79 V 50 H 70 Z"
            android:fillColor="#0D9488"/>
        <path
            android:pathData="M 79 47 H 80 V 50 H 79 Z"
            android:fillColor="#E2E8F0"/>
    </group>

    <!-- Table/Desk with Open Book on it -->
    <group android:name="table">
        <!-- Wooden table top bar -->
        <path
            android:pathData="M 20 59 H 88 V 61 H 20 Z"
            android:fillColor="#854D0E"/>
        <!-- Student's Hands writing in notebook -->
        <path
            android:pathData="M 40,59 C 42,57  48,57  50,59 Z"
            android:fillColor="#FDBA74"/>
        <!-- Open Notebook -->
        <path
            android:pathData="M 42 58 L 54 58 L 54 62 L 42 62 Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#CBD5E1"
            android:strokeWidth="0.2"/>
        <path
            android:pathData="M 54 58 L 66 58 L 66 62 L 54 62 Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#CBD5E1"
            android:strokeWidth="0.2"/>
        <!-- Stylized Writing Pen -->
        <path
            android:pathData="M 44,57 L 48,59"
            android:strokeColor="#0284C7"
            android:strokeWidth="0.4"/>
    </group>

    <!-- Curved Bottom Banner segment for "STUDY FOCUS" branding -->
    <path
        android:pathData="M 12 70 C 26 62, 82 62, 96 70 C 96 70, 93 92, 54 98 C 15 92, 12 70, 12 70 Z"
        android:fillColor="#0A192F"
        android:strokeColor="#00A8FF"
        android:strokeWidth="1"/>

    <!-- Bold letter design for TEXT: "STUDY" -->
    <!-- S -->
    <path
        android:pathData="M 28 73 C 28 71.5, 31 71.5, 31 72.5 C 31 73.5, 28 73.5, 28 74.5 C 28 75.5, 31 75.5, 31 74"
