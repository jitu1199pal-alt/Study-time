        android:strokeWidth="0.9"
        android:fillColor="#00000000"/>
    <!-- T -->
    <path
        android:pathData="M 34 71.5 H 38 M 36 71.5 V 75.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.9"/>
    <!-- U -->
    <path
        android:pathData="M 41 71.5 V 74.5 C 41 75.5, 44 75.5, 44 74.5 V 71.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.9"
        android:fillColor="#00000000"/>
    <!-- D -->
    <path
        android:pathData="M 47 71.5 H 49 C 51 71.5, 51 75.5, 49 75.5 H 47 V 71.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.9"
        android:fillColor="#00000000"/>
    <!-- Y -->
    <path
        android:pathData="M 53 71.5 L 55 73.5 M 57 71.5 L 55 73.5 V 75.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.9"/>


    <!-- Bold gradient letter design for TEXT: "FOCUS" -->
    <!-- F -->
    <path
        android:pathData="M 24 81.5 V 86.5 M 24 81.5 H 28.5 M 24 84 H 27.5"
        android:strokeColor="#00A8FF"
        android:strokeWidth="1.3"/>
    <!-- O -->
    <path
        android:pathData="M 35.5 84 A 2.2 2.5 0 1 0 35.5 84.1 Z"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.3"
        android:fillColor="#00000000"/>
    <!-- C -->
    <path
        android:pathData="M 49 82 C 48 81, 44 81, 44 84 C 44 87, 48 87, 49 86"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.3"
        android:fillColor="#00000000"/>
    <!-- U -->
    <path
        android:pathData="M 54 81.5 V 84.5 C 54 86.5, 58 86.5, 58 84.5 V 81.5"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.3"
        android:fillColor="#00000000"/>
    <!-- S -->
    <path
        android:pathData="M 64 82 C 64 81.2, 68 81.2, 68 83 C 68 84.5, 64 84, 64 85.5 C 64 86.8, 68 86.8, 68 85.8"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.3"
        android:fillColor="#00000000"/>

    <!-- Small Tagline: "FOCUS TODAY" and small open book icon -->
    <group android:name="tagline">
        <!-- Tagline separator line -->
        <path
            android:pathData="M 22,89.5 H 44 M 64,89.5 H 86"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="0.4"/>
        <!-- Small Open Book logo at the very bottom -->
        <path
            android:pathData="M 51 91 L 54 92 C 54 92, 55 91, 57 91 L 57 93 C 55 93, 54 94, 54 94 C 54 94, 53 93, 51 93 Z"
            android:fillColor="#00A8FF"/>
    </group>

</vector>
